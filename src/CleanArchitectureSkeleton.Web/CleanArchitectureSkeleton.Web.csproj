<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Le Web ne référence PAS Application : ce serait coupler la présentation aux ports/à l'orchestration
      internes du serveur (IOrderService, IUnitOfWork...) qui n'ont aucun sens côté client HTTP.
      Il ne dépend que du contrat public (Contracts) et du Domain (OrderStatus, simple enum sans
      dépendance technique) : le contrat de l'API ne doit pas être redupliqué à la main, mais il ne doit
      pas non plus entraîner avec lui toute la couche applicative.
    -->
    <ProjectReference Include="..\CleanArchitectureSkeleton.Contracts\CleanArchitectureSkeleton.Contracts.csproj" />
    <ProjectReference Include="..\CleanArchitectureSkeleton.Domain\CleanArchitectureSkeleton.Domain.csproj" />
    <ProjectReference Include="..\CleanArchitectureSkeleton.ServiceDefaults\CleanArchitectureSkeleton.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
