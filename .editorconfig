root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml,slnx}]
indent_size = 2

# Code généré (migrations EF Core) : on ne l'analyse pas.
[**/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
